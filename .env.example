# Aplicação
APP_NAME=SI AI Service
APP_ENV=development
LOG_LEVEL=info
API_PREFIX=/api/v1

# Segurança — chave usada pelo backend para chamar este serviço
INTERNAL_API_KEY=troque-por-uma-chave-segura

# Groq
GROQ_API_KEY=sua-chave-da-groq
GROQ_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER=groq
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.4

# CORS — URLs permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
